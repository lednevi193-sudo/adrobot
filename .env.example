# Скопируйте в .env (корень репозитория) и заполните.

# Keitaro Admin API
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=
# Без явного User-Agent Cloudflare стенда отвечает 403 (NFR-3)
KEITARO_USER_AGENT=keitaro-wrapper/0.1
KEITARO_TIMEOUT=20
# Общий кеш справочника офферов на процесс, секунды (0 — без кеша)
KEITARO_OFFERS_TTL=60
# Срок отметки Push: минуты * 60 должны быть больше 4 * KEITARO_TIMEOUT
PUSH_LEASE_MINUTES=5

# Обязательно: префикс названий «наших» кампаний на общем стенде (NFR-4, Q5), например test_ivanov_.
# Создаватор добавляет его к названию, редактор по нему показывает «наши» кампании и разрешает Push.
# Пустое значение или плейсхолдер с <...> — приложение не стартует.
CAMPAIGN_PREFIX=test_<фамилия>_

# Куда Keitaro кладёт новые кампании (FR-1.3); значения — для стенда tlgk.host
KEITARO_DOMAIN_ID=1813
KEITARO_GROUP_ID=10332
KEITARO_TRAFFIC_SOURCE_ID=836

# Postgres из docker-compose.yml
DATABASE_URL=postgresql+psycopg://adrobot:adrobot@127.0.0.1:15433/adrobot
# Тесты не читают .env. Альтернативную тестовую БД задайте в PowerShell:
# $env:TEST_DATABASE_URL = 'postgresql+psycopg://adrobot:adrobot@127.0.0.1:15433/adrobot_test'
